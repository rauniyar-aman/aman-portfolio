# Django
SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS - comma separated list of allowed origins (e.g. your frontend dev server)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Gemini (used server-side by the AI generation endpoint)
GEMINI_API_KEY=

# Gmail SMTP (used to send OTP codes for signup/password reset)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Google Sign-In (server-side ID token verification)
GOOGLE_CLIENT_ID=

# Facebook Login (server-side access token verification)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Database (optional - defaults to local SQLite if unset)
# DATABASE_URL=postgres://user:password@localhost:5432/dbname

# Django
SECRET_KEY=change-me-to-a-random-secret-key
# Safe-by-default is False (production). For local dev, set this to True.
DEBUG=False
# Comma separated. Defaults already cover localhost, Railway's *.up.railway.app,
# and api.rauniyaraman.com.np even if left unset here.
ALLOWED_HOSTS=

# CORS - comma separated list of allowed origins (e.g. your frontend dev server
# locally, or the deployed frontend domain in production)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Gemini (used server-side by the AI generation endpoint)
GEMINI_API_KEY=

# Gmail SMTP (used to send OTP codes for signup/password reset)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Google Sign-In (server-side ID token verification)
GOOGLE_CLIENT_ID=

# Facebook Login (server-side access token verification)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Database (optional - defaults to local SQLite if unset). Railway injects
# this automatically for its managed Postgres — no need to set it by hand.
# DATABASE_URL=postgres://user:password@localhost:5432/dbname
